
<!DOCTYPE html>
<html>
<head>
    <title>List of Products</title>

    <style>
        body {
            background-color: #eaf2f8;
            font-family: Arial, sans-serif;
            text-align: center;
            margin-top: 100px;
        }

        .container {
            background-color: white;
            width: 350px;
            margin: auto;
            padding: 30px;
            border-radius: 15px;
            box-shadow: 0px 4px 15px gray;
        }

        h2 {
            color: #2c3e50;
            font-size: 28px;
        }

        ol {
            text-align: left;
            padding-left: 50px;
        }

        li {
            padding: 12px;
            font-size: 20px;
            color: #333;
        }

        a {
            text-decoration: none;
            color: #007bff;
            font-weight: bold;
        }

        a:hover {
            color: #e74c3c;
            text-decoration: underline;
        }
    </style>
</head>

<body>

    <div class="container">

        <h2><b><i>List of Products</i></b></h2>

        <ol>
            <li>
                <a href="https://www.amazon.in/s?k=dresses" target="_blank">
                    Dresses
                </a>
            </li>

            <li>
                <a href="https://www.amazon.in/s?k=toys" target="_blank">
                    Toys
                </a>
            </li>

            <li>
                <a href="https://www.amazon.in/s?k=utensils" target="_blank">
                    Utensils
                </a>
            </li>
        </ol>

    </div>

</body>
</html>
